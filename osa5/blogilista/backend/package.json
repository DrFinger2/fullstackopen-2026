{
  "name": "blogilista-backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build:render": "npm install && rm -rf dist && cd ../frontend/ && npm install && npm run build && cp -r dist ../backend",
    "build": "powershell -NoProfile -Command \"npm.cmd install; if (Test-Path dist) { Remove-Item -Recurse -Force dist }; Set-Location ../frontend; npm.cmd install; npm.cmd run build; Copy-Item dist ../backend -Recurse -Force; Set-Location ../backend\"",
    "start": "cross-env NODE_ENV=prod LOG_LEVEL=info node index.js",
    "dev":   "cross-env NODE_ENV=dev LOG_LEVEL=info node --watch index.js",
    "test":  "cross-env NODE_ENV=test LOG_LEVEL=silent node --test --test-concurrency=1",
    "start:test": "cross-env NODE_ENV=test LOG_LEVEL=info node --watch index.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "supertest": "^7.2.2"
  }
}
